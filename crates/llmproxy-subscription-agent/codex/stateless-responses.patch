diff --git a/codex-rs/app-server/src/llmproxy_proxy.rs b/codex-rs/app-server/src/llmproxy_proxy.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/app-server/src/llmproxy_proxy.rs
@@ -0,0 +1,348 @@
+//! Stateless native-auth Responses transport. This module never creates a thread or runs a tool.
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use base64::Engine;
+use base64::engine::general_purpose::STANDARD;
+use codex_app_server_protocol::{
+    JSONRPCErrorError, LlmproxyCapabilitiesResponse, LlmproxyChunkNotification,
+    LlmproxyResponsesHead, ServerNotification,
+};
+use codex_core::config::Config;
+use codex_http_client::{ClientRouteClass, HttpClientBuilder, HttpResponse};
+use codex_login::AuthManager;
+use codex_model_provider::{SharedModelProvider, WorkspaceRoutingContext, create_model_provider};
+use codex_model_provider_info::ModelProviderInfo;
+use serde_json::Value;
+use tokio_util::sync::CancellationToken;
+
+use crate::outgoing_message::{ConnectionRequestId, OutgoingMessageSender};
+
+pub(crate) fn failure() -> JSONRPCErrorError {
+    JSONRPCErrorError {
+        code: -32000,
+        message: "stateless Codex Responses request failed".into(),
+        data: None,
+    }
+}
+
+pub(crate) struct Proxy {
+    config: Arc<Config>,
+    provider: SharedModelProvider,
+    auth: Arc<AuthManager>,
+    routing: WorkspaceRoutingContext,
+    outgoing: Arc<OutgoingMessageSender>,
+    active: Mutex<HashMap<ConnectionRequestId, CancellationToken>>,
+}
+
+impl Proxy {
+    pub(crate) fn new(
+        config: Arc<Config>,
+        auth: Arc<AuthManager>,
+        outgoing: Arc<OutgoingMessageSender>,
+    ) -> Arc<Self> {
+        Arc::new(Self {
+            provider: create_model_provider(
+                ModelProviderInfo::create_openai_provider(Some(format!(
+                    "{}/codex",
+                    config.chatgpt_base_url.trim_end_matches('/')
+                ))),
+                Some(auth.clone()),
+            ),
+            auth,
+            routing: WorkspaceRoutingContext::new(config.chatgpt_base_url.clone()),
+            config,
+            outgoing,
+            active: Mutex::new(HashMap::new()),
+        })
+    }
+
+    pub(crate) async fn capabilities(
+        &self,
+    ) -> Result<LlmproxyCapabilitiesResponse, JSONRPCErrorError> {
+        if !crate::llmproxy_proxy_mode() {
+            return Err(failure());
+        }
+        let native_auth_ready =
+            self.provider.auth().await.is_some_and(|auth| {
+                auth.is_chatgpt_auth() && !auth.is_personal_access_token_auth()
+            });
+        Ok(LlmproxyCapabilitiesResponse {
+            policy_version: 1,
+            stateless: true,
+            client_tools_only: true,
+            native_auth_ready,
+        })
+    }
+
+    pub(crate) fn connection_closed(&self, connection_id: crate::outgoing_message::ConnectionId) {
+        for (id, token) in self.active.lock().unwrap().iter() {
+            if id.connection_id == connection_id {
+                token.cancel();
+            }
+        }
+    }
+
+    pub(crate) fn cancel(&self, id: &ConnectionRequestId) {
+        if let Some(token) = self.active.lock().unwrap().get(id) {
+            token.cancel();
+        }
+    }
+
+    pub(crate) fn start(
+        self: &Arc<Self>,
+        id: ConnectionRequestId,
+        request: Value,
+    ) -> Result<(), JSONRPCErrorError> {
+        if !crate::llmproxy_proxy_mode() || !valid_request(&request) {
+            return Err(failure());
+        }
+        let token = CancellationToken::new();
+        {
+            let mut active = self.active.lock().unwrap();
+            if active.len() >= 64 || active.contains_key(&id) {
+                return Err(failure());
+            }
+            active.insert(id.clone(), token.clone());
+        }
+        let proxy = self.clone();
+        tokio::spawn(async move {
+            let _guard = ActiveRequest {
+                proxy: proxy.clone(),
+                id: id.clone(),
+            };
+            let mut head_sent = false;
+            let operation = async {
+                let mut recovery = proxy.auth.unauthorized_recovery();
+                let mut response = proxy.fetch(&request).await?;
+                // 仅对明确拒绝认证的 401 使用原生恢复，不重放断开的模型请求。
+                while response.status().as_u16() == 401 && recovery.has_next() {
+                    recovery.next().await.map_err(|_| "refresh")?;
+                    response = proxy.fetch(&request).await?;
+                }
+                drop(request);
+                let head = LlmproxyResponsesHead {
+                    status: response.status().as_u16(),
+                    content_type: response
+                        .headers()
+                        .get("content-type")
+                        .and_then(|v| v.to_str().ok())
+                        .map(str::to_owned),
+                };
+                proxy.outgoing.send_response(id.clone(), head).await;
+                head_sent = true;
+                while let Some(bytes) = response.chunk().await.map_err(|_| "stream")? {
+                    for part in bytes.chunks(32 * 1024) {
+                        proxy.chunk(&id, STANDARD.encode(part), false, false).await;
+                    }
+                }
+                proxy.chunk(&id, String::new(), true, false).await;
+                Ok::<_, &'static str>(())
+            };
+            let result = tokio::select! {
+                _ = token.cancelled() => Err("cancelled"),
+                result = tokio::time::timeout(Duration::from_secs(300), operation) => result.unwrap_or(Err("timeout")),
+            };
+            if let Err(stage) = result {
+                let report = async {
+                    if head_sent {
+                        proxy.chunk(&id, String::new(), true, true).await;
+                    } else {
+                        let mut error = failure();
+                        error.data = Some(serde_json::json!({"stage":stage}));
+                        proxy.outgoing.send_error(id, error).await;
+                    }
+                };
+                let _ = tokio::time::timeout(Duration::from_secs(2), report).await;
+            }
+        });
+        Ok(())
+    }
+
+    async fn fetch(&self, request: &Value) -> Result<HttpResponse, &'static str> {
+        if !self
+            .provider
+            .auth()
+            .await
+            .is_some_and(|auth| auth.is_chatgpt_auth() && !auth.is_personal_access_token_auth())
+        {
+            return Err("native_auth");
+        }
+        let resolved = self
+            .provider
+            .responses_api_provider(&self.routing)
+            .await
+            .map_err(|_| "routing")?;
+        let url = resolved.provider.url_for_path("responses");
+        let mut headers = codex_login::default_client::default_headers();
+        headers.extend(resolved.provider.headers);
+        self.provider
+            .api_auth()
+            .await
+            .map_err(|_| "authentication")?
+            .add_auth_headers(&mut headers);
+        let client = HttpClientBuilder::new()
+            .without_redirects()
+            .without_request_logging()
+            .with_chatgpt_cookies(&self.config.http_client_factory())
+            .build_respecting_outbound_proxy_policy(
+                &self.config.http_client_factory(),
+                &url,
+                ClientRouteClass::Api,
+            )
+            .map_err(|_| "network_policy")?;
+        client
+            .post(&url)
+            .headers(headers)
+            .json(request)
+            .send()
+            .await
+            .map_err(|_| "http")
+    }
+
+    async fn chunk(&self, id: &ConnectionRequestId, data: String, end: bool, error: bool) {
+        self.outgoing
+            .send_server_notification_to_connections(
+                &[id.connection_id],
+                ServerNotification::LlmproxyChunk(LlmproxyChunkNotification {
+                    request_id: id.request_id.clone(),
+                    data,
+                    end,
+                    error,
+                }),
+            )
+            .await;
+    }
+}
+
+struct ActiveRequest {
+    proxy: Arc<Proxy>,
+    id: ConnectionRequestId,
+}
+impl Drop for ActiveRequest {
+    fn drop(&mut self) {
+        self.proxy.active.lock().unwrap().remove(&self.id);
+    }
+}
+
+fn client_tools(value: &Value) -> bool {
+    value.as_array().is_some_and(|tools| {
+        tools.iter().all(|tool| match tool["type"].as_str() {
+            Some("function" | "custom") => true,
+            Some("namespace") => client_tools(&tool["tools"]),
+            _ => false,
+        })
+    })
+}
+
+fn valid_request(request: &Value) -> bool {
+    request.is_object()
+        && request["store"] == false
+        && request["stream"] == true
+        && request["model"].as_str().is_some_and(|v| !v.is_empty())
+        && ["previous_response_id", "conversation"]
+            .iter()
+            .all(|name| request[*name].is_null())
+        && request
+            .get("background")
+            .is_none_or(|v| v.is_null() || v == false)
+        && request
+            .get("tools")
+            .is_none_or(|v| v.is_null() || client_tools(v))
+        && request
+            .get("additional_tools")
+            .is_none_or(|v| v.is_null() || client_tools(v))
+        && request["input"].as_array().is_some_and(|items| {
+            items.iter().all(|item| {
+                item.get("tools")
+                    .is_none_or(|v| v.is_null() || client_tools(v))
+            })
+        })
+        && serde_json::to_vec(request).is_ok_and(|bytes| bytes.len() <= 16 * 1024 * 1024)
+}
+
+#[cfg(test)]
+mod llmproxy_proxy_tests {
+    use super::*;
+    use serde_json::json;
+
+    #[tokio::test]
+    async fn native_transport_preserves_http_status_bytes_account_and_parallel_tool_ids() {
+        use codex_core::config::{ConfigBuilder, LoaderOverrides};
+        use codex_login::CodexAuth;
+        use wiremock::matchers::{header, method};
+        use wiremock::{Mock, MockServer, ResponseTemplate};
+        let server = MockServer::start().await;
+        let source = "event: response.completed\ndata: {\"type\":\"response.completed\",\"response\":{\"id\":\"r\",\"output\":[{\"type\":\"function_call\",\"name\":\"exec_command\",\"call_id\":\"call_1\",\"arguments\":\"{}\"},{\"type\":\"function_call\",\"name\":\"apply_patch\",\"call_id\":\"call_2\",\"arguments\":\"{}\"}]}}\n\n";
+        Mock::given(method("POST"))
+            .and(header("ChatGPT-Account-ID", "account_id"))
+            .respond_with(
+                ResponseTemplate::new(200)
+                    .insert_header("content-type", "text/event-stream")
+                    .set_body_string(source),
+            )
+            .expect(2)
+            .mount(&server)
+            .await;
+        let home = tempfile::tempdir().unwrap();
+        let mut config = ConfigBuilder::default()
+            .codex_home(home.path().to_path_buf())
+            .loader_overrides(LoaderOverrides::without_managed_config_for_tests())
+            .build()
+            .await
+            .unwrap();
+        config.chatgpt_base_url = server.uri();
+        let auth =
+            AuthManager::from_auth_for_testing(CodexAuth::create_dummy_chatgpt_auth_for_testing());
+        let (tx, _rx) = tokio::sync::mpsc::channel(8);
+        let outgoing = Arc::new(OutgoingMessageSender::new(
+            tx,
+            codex_analytics::AnalyticsEventsClient::disabled(),
+        ));
+        let proxy = Proxy::new(Arc::new(config), auth, outgoing);
+        let request = json!({"model":"m","instructions":"","store":false,"stream":true,"input":[
+            {"type":"function_call","name":"exec_command","call_id":"call_1","arguments":"{}"},
+            {"type":"function_call_output","call_id":"call_1","output":"client result"}
+        ],"tools":[{"type":"function","name":"exec_command","parameters":{"type":"object"}}],"future":{"preserve":true}});
+        let (first, second) = tokio::join!(proxy.fetch(&request), proxy.fetch(&request));
+        for response in [first, second] {
+            let mut response = response.unwrap();
+            assert_eq!(response.status().as_u16(), 200);
+            let mut body = Vec::new();
+            while let Some(bytes) = response.chunk().await.unwrap() {
+                body.extend(bytes);
+            }
+            assert_eq!(body, source.as_bytes());
+        }
+        let captured = server.received_requests().await.unwrap();
+        assert!(
+            captured
+                .iter()
+                .all(
+                    |received| serde_json::from_slice::<Value>(&received.body).unwrap() == request
+                )
+        );
+        assert!(!home.path().join("sessions").exists());
+        assert!(!home.path().join("history.jsonl").exists());
+    }
+
+    #[test]
+    fn persistence_and_hosted_tools_are_rejected_before_transport() {
+        let good = json!({"model":"m","store":false,"stream":true,"input":[],"tools":[{"type":"function","name":"exec_command"}]});
+        assert!(valid_request(&good));
+        for (name, value) in [
+            ("store", json!(true)),
+            ("background", json!(true)),
+            ("previous_response_id", json!("r")),
+            (
+                "tools",
+                json!([{"type":"namespace","tools":[{"type":"web_search"}]}]),
+            ),
+        ] {
+            let mut bad = good.clone();
+            bad[name] = value;
+            assert!(!valid_request(&bad));
+        }
+    }
+}
