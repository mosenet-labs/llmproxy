# Local development only. Copy to .env and fill in credentials.
LLMPROXY_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/llmproxy_dev
LLMPROXY_TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/llmproxy_test
# Base64-encoded 32 random bytes. Keep the same key when restarting either service.
# python3 -c 'import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())'
LLMPROXY_MASTER_KEY=
LLMPROXY_LISTEN=127.0.0.1:3200

# One process for /ui and /v1/*; shared identity for all telemetry signals.
OTEL_SERVICE_NAME=llmproxy
# Optional shared OTLP/HTTP exporter. Unset/empty endpoint keeps stdout logs only.
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:5080/api/default
# OTEL_EXPORTER_OTLP_HEADERS="authorization=Basic%20<base64(email:password)>,stream-name=llmproxy"
# OTEL_EXPORTER_OTLP_TIMEOUT=10000
# RUST_LOG=warn,llmproxy=info,llmproxy_console=info,llmproxy_telemetry=info
