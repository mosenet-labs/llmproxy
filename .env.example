# 默认使用 ./data/llmproxy.sqlite3 持久化 SQLite 数据库，无需配置数据库环境变量。
# 同目录下的 .key 文件仅生成一次，请将数据库与密钥文件一起备份。
# LLMPROXY_DATABASE_URL=sqlite:/absolute/path/to/llmproxy.sqlite3
# 使用 PostgreSQL 时，请配置数据库连接地址和固定的 Base64 主密钥。
# LLMPROXY_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/llmproxy_dev
# LLMPROXY_TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/llmproxy_test
# 主密钥由 32 个随机字节经 Base64 编码生成；SQLite 可选，PostgreSQL 必填。
# python3 -c 'import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())'
# LLMPROXY_MASTER_KEY=
LLMPROXY_LISTEN=127.0.0.1:3200
# 控制台默认启用共享 WebSocket；环境不支持升级时设置 false 并重启，使用 HTTP 增量更新。
# LLMPROXY_UI_WEBSOCKET=false

# 可选的订阅代理节点注册与转接功能，以下两项必须同时配置。
# 使用两个不同的密钥，每个至少 32 个字符；两项均不设置时禁用此功能。
# 注册密钥供节点使用，内部转接密钥仅保留在 llmproxy 服务端。
# 分别执行两次以下命令，将生成的两个不同密钥填入对应配置项：
# openssl rand -hex 32
# 也可使用 Python 生成：
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# LLMPROXY_SUBSCRIPTION_REGISTRATION_KEY=<registration-key-at-least-32-characters>
# LLMPROXY_SUBSCRIPTION_RELAY_KEY=<relay-key-at-least-32-characters>

# 同一进程提供 /ui 和 /v1/* 服务，所有遥测信号共用服务名称。
OTEL_SERVICE_NAME=llmproxy
# 可选的统一 OTLP/HTTP 遥测导出；端点未设置或为空时，仅向标准输出写日志。
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:5080/api/default
# OTEL_EXPORTER_OTLP_HEADERS="authorization=Basic%20<base64(email:password)>,stream-name=llmproxy"
# OTEL_EXPORTER_OTLP_TIMEOUT=10000
# RUST_LOG=warn,llmproxy=info,llmproxy_console=info,llmproxy_telemetry=info
